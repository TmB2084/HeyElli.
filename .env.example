# Ausschließlich lokale Entwicklung mit Beispieldaten.
POSTGRES_USER=serviceplattform
POSTGRES_PASSWORD=local_example_password
POSTGRES_DB=serviceplattform
POSTGRES_PORT=5432
# Optional bearer token for raw local PDS contract endpoints; no production target is enabled.
SIMULATOR_API_TOKEN=
# Legacy prepared transport placeholders. Active PDS configuration and explicit read-only release now live in Verwaltung → PDS-Anbindung. These variables never activate a source.
# One central technical API account for the entire platform; never a per-user token.
PDS_API_BASE_URL=
PDS_API_TOKEN=

# Authentication: heyelli accounts with their own password (stored hashed in PostgreSQL), no variables needed.
# First administrator: npm run auth:admin (prints a one-time start password). The Microsoft login
# (Einstellungen → Integrationen → Microsoft-Anmeldung) replaces password login once activated.

# Central platform storage: development uses the local POSTGRES_* values above.
# Production remains blocked until separate infrastructure is configured.
APP_ENV=development
# Assigned only by the isolated test runner; never point tests at development.
HEYELLI_TEST_DATABASE_URL=
# Assigned only by the isolated test runner: separate temporary legacy-settings directory.
HEYELLI_TEST_SETTINGS_DIR=

# Server-only Microsoft 365 app credentials, optional for connection test.
# UUIDs of tenant/app registration; keep secret only in excluded local .env.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Test mode defaults to enabled in PostgreSQL. Only an administrator may explicitly enable live sending in the UI.

# Microsoft Entra login is configured only under Verwaltung → Microsoft-Anmeldung.
# The excluded .env.microsoft-auth.ui.local contains MS_AUTH_ENCRYPTED_CONFIG.
# No NEXT_PUBLIC_ variables or Graph mail credentials are used by this module.
# The encryption key stays under .local/microsoft-auth-secrets/master.key.

# Replacement Microsoft login credentials stay in excluded .env.microsoft-auth.pending.local until the interactive test succeeds.
# A previous encrypted baseline is retained in .env.microsoft-auth.previous.local after successful replacement.

# Copilot Studio is configured only in Einstellungen → Integrationen → Copilot.
# Encrypted COPILOT_ENCRYPTED_CONFIG lives in excluded .env.copilot.<config-id>.local files.
# Key: .local/copilot-secrets/master.key; no NEXT_PUBLIC_ or shared Graph credentials.
# Disabled by default in PostgreSQL; connection test never enables it.

# BMACloud is configured under Einstellungen → Integrationen → BMACloud.
# Encrypted BMACLOUD_ENCRYPTED_CONFIG lives in excluded .env.bmacloud.<config-id>.local files.
# Key: .local/bmacloud-secrets/master.key. No token is returned to the browser.
# PostgreSQL migration 029 stores versioned configuration references and explicit read-only release.

# Optional trusted reverse-proxy header containing exactly one client IP (lowercase x-* name).
# Leave empty for local/direct use: forwarded headers are ignored and account-based limits apply.
# Set ONLY when an isolated proxy overwrites this header and direct app access is blocked.
# Example name only, not enabled by default: x-heyelli-client-ip
AUTH_LOGIN_SOURCE_HEADER=

# Only behind a TLS reverse proxy: public origin (scheme + host) used for same-origin checks and CSP reporting.
# Applies only when the validated Host matches exactly; forwarded headers are never trusted. Example: https://heyelli.example.invalid
HEYELLI_PUBLIC_ORIGIN=
# Comma-separated hostnames allowed to load Next.js dev resources (allowedDevOrigins), e.g. heyelli.example.invalid
HEYELLI_DEV_ORIGINS=

# Nur separat gestartete Überwachung; npm run dev übergibt seinen Port und die lokale Bind-Adresse.
HEYELLI_MONITOR_PORT=3000
# localhost prüft IPv4 und IPv6, alternativ ausschließlich 127.0.0.1 oder ::1.
HEYELLI_MONITOR_HOST=localhost
