# Vorlage für /opt/heyelli-test/.env und /opt/heyelli-prod/.env (Container-Betrieb). Gehört nicht ins Git.
# Eigentümer root:root, Rechte 600. Keine Kommentare hinter Werten (Compose übernimmt sie sonst in den Wert).
# Alle Werte hier sind Platzhalter. Echte Werte nie in Tickets, Chats oder Repos weitergeben.
# Die Variablen aus .env.example (M365_*, PDS_* usw.) gelten unverändert und werden hier ergänzt.

# ---- Compose (Instanz) ----
# HEYELLI_TAG schreibt das Deploy-Skript in .env.tag, dort gilt der echte Wert (Platzhalter nur für die Syntaxprüfung).
HEYELLI_TAG=0000000
# Prod 3000, Test 3001 (nur 127.0.0.1, davor nginx)
HEYELLI_PORT=3000
# Bridge-Namen, höchstens 15 Zeichen: Prod br-hey-prod-int / br-hey-prod-ext, Test br-hey-test-int / br-hey-test-ext
HEYELLI_BRIDGE_INTERN=br-hey-prod-int
HEYELLI_BRIDGE_EXTERN=br-hey-prod-ext
# gemeinsames internes Netz zum Ollama-Dienst (deploy/server/ollama/compose.yaml)
OLLAMA_NETWORK=heyelli-ollama

# ---- Datenbank (Dienst "db" im selben Compose-Projekt) ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=serviceplattform
POSTGRES_PASSWORD=hier-ein-langes-zufallspasswort
POSTGRES_DB=serviceplattform

# ---- Anwendung ----
# "server" erlaubt zusammen mit dem im Image gesetzten HEYELLI_SERVER_BETRIEB=1 den Produktionsmodus
APP_ENV=server
HEYELLI_PUBLIC_ORIGIN=https://heyelli.elomech.de
# Standard http://127.0.0.1:11434, im Container der Dienstname des Ollama-Stacks
OLLAMA_BASE_URL=http://ollama:11434
# Elli (lokaler Assistent) ist in Test UND Prod aktiv (Entscheidung 18.11.2026). Beide Instanzen nutzen denselben Ollama-Stack
# (deploy/server/ollama/, Netz heyelli-ollama). Das Deploy-Skript bricht ab, wenn Ollama dann nicht erreichbar ist.
HEYELLI_ELLI_AKTIV=1

# ---- Anmeldung ----
# heyelli-Konten mit eigenem Passwort, bis die Microsoft-Anmeldung (Einstellungen → Integrationen) aktiviert ist; dann nur noch Microsoft.
# Keine Variablen nötig. Erster Administrator nach dem Deploy: heyelli-compose.sh <instanz> exec app node scripts/bootstrap-admin.mjs
# (Benutzername admin, Startpasswort wird einmal ausgegeben und muss bei der ersten Anmeldung geändert werden).

# ---- Nur Testinstanz (auf Prod alle leer lassen) ----
# Hinweisbalken auf jeder Seite
HEYELLI_INSTANZ_HINWEIS=
# aus = Mails nur simulieren, umleiten = alle Mails nur an HEYELLI_MAIL_UMLEITUNG
HEYELLI_MAIL_MODUS=
HEYELLI_MAIL_UMLEITUNG=
# aus = keine schreibenden Zugriffe auf Microsoft Graph (SharePoint) und kein Copilot (Elli nutzt dann Ollama)
HEYELLI_EXTERN_SCHREIBEN=
